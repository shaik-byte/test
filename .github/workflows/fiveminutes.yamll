name: Run Shell Script Every 5 Minutes

on:
  schedule:
    # Runs at every 5th minute
    - cron: '*/5 * * * *'

jobs:
  run-shell:
    runs-on: self-hosted

    steps:
      - name: Checkout repository
        uses: actions/checkout@v3

      - name: Run shell script
        run: |
          echo "hi"
